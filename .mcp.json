{
  "mcpServers": {
    "oci": {
      "command": "uvx",
      "args": [
        "oracle.oci-cloud-mcp-server@latest"
      ],
      "env": {
        "OCI_CONFIG_PROFILE": "DEFAULT",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "openwa": {
      "type": "http",
      "url": "${OPENWA_MCP_URL:-}",
      "headers": {
        "Authorization": "Bearer ${OPENWA_MCP_KEY:-}"
      }
    },
    "wafine": {
      "type": "http",
      "url": "${WAFINE_MCP_URL:-}"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ]
    }
  }
}
