#!/usr/bin/env bash
# HTTP smoke test for a WAFINE go-live (docs/go-live-2026-10-20.md). Read-only: GET requests, plus
# one POST /waitlist with an EMPTY body that the validator rejects (400) before anything is stored.
#
#   WEB_URL=https://app.example.com API_URL=https://api.example.com \
#   DOCS_URL=https://docs.example.com scripts/go-live-check
#
# Targets may be bare hosts or URLs. DOCS_URL is optional (its checks are skipped without it).
# Prints one `PASS|FAIL|SKIP <check> <detail>` line per check and exits 1 if any check failed,
# 2 on a usage error. CURL_TIMEOUT (seconds, default 15) bounds each request.
set -euo pipefail

usage() {
  sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

case "${1:-}" in -h|--help) usage ;; esac

url_of() { # bare host or URL -> https URL without a trailing slash
  local v="${1%/}"
  case "$v" in http://*|https://*) printf '%s' "$v" ;; *) printf 'https://%s' "$v" ;; esac
}

[ -n "${WEB_URL:-}" ] && [ -n "${API_URL:-}" ] || { echo "go-live-check: WEB_URL and API_URL are required" >&2; usage; }
command -v curl >/dev/null 2>&1 || { echo "go-live-check: curl not found" >&2; exit 2; }

WEB="$(url_of "$WEB_URL")"
API="$(url_of "$API_URL")"
DOCS=""
[ -z "${DOCS_URL:-}" ] || DOCS="$(url_of "$DOCS_URL")"
TIMEOUT="${CURL_TIMEOUT:-15}"
BODY="$(mktemp)"
trap 'rm -f "$BODY"' EXIT

failed=0
pass() { printf 'PASS %-16s %s\n' "$1" "$2"; }
fail() { printf 'FAIL %-16s %s\n' "$1" "$2"; failed=1; }
skip() { printf 'SKIP %-16s %s\n' "$1" "$2"; }

# code <curl args...>: prints the HTTP status (000 when unreachable), body saved in $BODY.
code() { curl -sS -o "$BODY" -m "$TIMEOUT" -w '%{http_code}' "$@" 2>/dev/null || true; }

expect() { # expect <check> <want> <got> <url>
  if [ "$3" = "$2" ]; then pass "$1" "$3 $4"; else fail "$1" "want $2, got $3 $4"; fi
}

# --- web ----------------------------------------------------------------------------------------
c="$(code "$WEB/")"
title="$(tr -d '\n' <"$BODY" | grep -o '<title>[^<]*' | head -1 | sed 's/<title>//' || true)"
if [ "$c" != 200 ]; then
  fail web-home "want 200, got $c $WEB/"
elif grep -qi 'waasel' <<<"$title"; then
  fail web-home "old brand: title \"$title\" (pre-rebrand build still deployed)"
elif grep -qi 'wafine' <<<"$title"; then
  pass web-home "200, title \"$title\""
else
  fail web-home "200 but title \"$title\" lacks WaFine"
fi

for path in /fr /ar /robots.txt /llms.txt; do
  expect "web${path//\//-}" 200 "$(code "$WEB$path")" "$WEB$path"
done

# The same-origin proxy is wired to the BFF only when BFF_URL is set on the web project:
# 401 = forwarded and rejected for lack of a session, 503 = bff_not_configured.
expect web-bff-proxy 401 "$(code "$WEB/api/bff/api/me")" "$WEB/api/bff/api/me"

# --- api ----------------------------------------------------------------------------------------
expect api-health 200 "$(code "$API/health")" "$API/health"

# A mounted waitlist route validates first: an empty body is a 400 and stores nothing.
# 404 means the BFF on the VM predates the waitlist (or its storage is not wired).
expect api-waitlist 400 "$(code -X POST -H 'content-type: application/json' --data '{}' "$API/waitlist")" "POST $API/waitlist {}"

expect api-auth-gate 401 "$(code "$API/api/me")" "$API/api/me (no token)"
expect api-oauth 200 "$(code "$API/.well-known/oauth-authorization-server")" "$API/.well-known/oauth-authorization-server"

# /mcp only has to answer: a GET without a session is 401, 405 or 406 depending on the transport.
c="$(code "$API/mcp")"
case "$c" in
  200|401|405|406) pass api-mcp "$c $API/mcp" ;;
  *) fail api-mcp "want 200/401/405/406, got $c $API/mcp" ;;
esac

# --- docs (optional) ----------------------------------------------------------------------------
if [ -n "$DOCS" ]; then
  # The docs site is public: the root and the English home answer 200 without credentials,
  # and the legacy /docs prefix must 308-redirect to the site root.
  expect docs-home 200 "$(code -L "$DOCS/")" "$DOCS/"
  expect docs-en 200 "$(code -L "$DOCS/en")" "$DOCS/en"
  expect docs-legacy-redirect 308 "$(code "$DOCS/docs")" "$DOCS/docs"
else
  skip docs-home "DOCS_URL not set"
fi

if [ "$failed" = 0 ]; then echo "go-live-check: all checks passed"; else echo "go-live-check: FAILED"; fi
exit "$failed"
