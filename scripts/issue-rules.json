  "issue_rules": [
    {
      "match": "\\b(rate.?limit|trigram|xss|crlf|rls|secret|cve|auth.?by.?pas|revocation|security hardening)\\b",
      "labels": [
        "area:security"
      ]
    },
    {
      "match": "\\b(security)\\b",
      "labels": [
        "type:security"
      ]
    },
    {
      "match": "\\b(changelog|readme|i18n|rtl|translat|arabic|french|docs?)\\b",
      "labels": [
        "area:docs"
      ]
    },
    {
      "match": "\\b(landing|hero|stub pages|a11y|boundary|next\\.?js|og image)\\b",
      "labels": [
        "area:web"
      ]
    },
    {
      "match": "\\b(oauth|bff|gateway proxy|presign|revocation)\\b",
      "labels": [
        "area:bff"
      ]
    },
    {
      "match": "\\b(r2|media|backup|tunnel|terraform|tofu|oci\\b|dns|vps|nginx|caddy)\\b",
      "labels": [
        "area:infra"
      ]
    },
    {
      "match": "\\b(dependabot|actions|checkout|upload-artifact|ci\\b|workflow|billing)\\b",
      "labels": [
        "area:ops"
      ]
    },
    {
      "match": "\\b(logo|brand pack|design system|svg|banner)\\b",
      "labels": [
        "area:brand"
      ]
    },
    {
      "match": "\\b(invite|waitlist|pricing|beta)\\b",
      "labels": [
        "area:growth"
      ]
    },
    {
      "match": "\\b(bug|broken|error|regression|fails?|cannot|can't)\\b",
      "labels": [
        "type:bug"
      ]
    },
    {
      "match": "\\b(cve|secret leak|auth bypass|rce\\b|sql injection)\\b",
      "labels": [
        "P0"
      ]
    },
    {
      "match": "\\b(security|hardening)\\b",
      "labels": [
        "P1"
      ]
    }
  ],
  "pr_path_rules": [
    {
      "path": "terraform/",
      "label": "area:infra"
    },
    {
      "path": "stack/",
      "label": "area:infra"
    },
    {
      "path": "dns/",
      "label": "area:infra"
    },
    {
      "path": "app/web/",
      "label": "area:web"
    },
    {
      "path": "app/bff/",
      "label": "area:bff"
    },
    {
      "path": "app/docs/",
      "label": "area:docs"
    },
    {
      "path": "docs/",
      "label": "area:docs"
    },
    {
      "path": "scripts/",
      "label": "area:ops"
    },
    {
      "path": ".github/",
      "label": "area:ops"
    },
    {
      "path": "CHANGELOG.md",
      "label": "area:ops"
    }
  ]
}
