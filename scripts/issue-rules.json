{
  "$comment": "Single source of truth for the issue/PR hygiene triage. Repo-agnostic on purpose: repo slugs are passed via --repo, never stored here, so older public snapshots of this file cannot leak the private dev repo's name. See docs/issue-hygiene-rules.md.",
  "version": 1,
  "stale_days": {
    "default": 60,
    "overrides": []
  },
  "pr_stale_days": 7,
  "labels": {
    "status:needs-triage": {
      "color": "ededed",
      "description": "No area/priority labels derived yet — owner review"
    },
    "status:launch-blocking": {
      "color": "b60205",
      "description": "P0 work that must be closed before the go-live check can pass"
    }
  },
  "wf_map": {
    "WF-001": { "milestone": "M0", "area": "area:security", "priority": "P0", "type": "type:security" },
    "WF-002": { "milestone": "M0", "area": "area:security", "priority": "P0", "type": "type:security" },
    "WF-003": { "milestone": "M0", "area": "area:docs", "priority": "P0", "type": "type:task" },
    "WF-004": { "milestone": "M0", "area": "area:security", "priority": "P0", "type": "type:security" },
    "WF-005": { "milestone": "M0", "area": "area:security", "priority": "P1", "type": "type:security" },
    "WF-006": { "milestone": "M0", "area": "area:security", "priority": "P1", "type": "type:security" },
    "WF-007": { "milestone": "M0", "area": "area:web", "priority": "P1", "type": "type:task" },
    "WF-008": { "milestone": "M0", "area": "area:web", "priority": "P1", "type": "type:task" },
    "WF-009": { "milestone": "M0", "area": "area:ops", "priority": "P1", "type": "type:task" },
    "WF-010": { "milestone": "M0", "area": "area:ops", "priority": "P1", "type": "type:task" },
    "WF-011": { "milestone": "M0", "area": "area:ops", "priority": "P1", "type": "type:task" },
    "WF-012": { "milestone": "M0", "area": "area:ops", "priority": "P1", "type": "type:task" }
  },
  "milestones": [
    { "title": "M9", "due": "2026-11-30" },
    { "title": "M10", "due": "2026-12-15" },
    { "title": "M11", "due": "2026-12-20" }
  ],
  "issue_rules": [
    { "match": "^M\\d+ .", "labels": ["type:task"] },
    { "match": "\\b(rate.?limit|trigram|xss|crlf|rls|secret|cve|auth.?by.?pas|revocation|security hardening)\\b", "labels": ["area:security"] },
    { "match": "\\b(security)\\b", "labels": ["type:security"] },
    { "match": "\\b(changelog|readme|i18n|rtl|translat|arabic|french|docs?)\\b", "labels": ["area:docs"] },
    { "match": "\\b(landing|hero|stub pages|a11y|boundary|next\\.?js|og image)\\b", "labels": ["area:web"] },
    { "match": "\\b(oauth|bff|gateway proxy|presign|inbox endpoints|rate)\\b", "labels": ["area:bff"] },
    { "match": "\\b(r2|media|backup|tunnel|terraform|tofu|oci\\b|dns|vps|nginx|caddy)\\b", "labels": ["area:infra"] },
    { "match": "\\b(dependabot|actions|checkout|upload-artifact|ci\\b|workflow|billing)\\b", "labels": ["area:ops"] },
    { "match": "\\b(logo|brand pack|design system|svg|banner)\\b", "labels": ["area:brand"] },
    { "match": "\\b(invite|waitlist|pricing|beta)\\b", "labels": ["area:growth"] },
    { "match": "\\b(bug|broken|error|regression|fails?|cannot|can't)\\b", "labels": ["type:bug"] },
    { "match": "\\b(cve|secret leak|auth bypass|rce\\b|sql injection)\\b", "labels": ["P0"] },
    { "match": "\\b(security|hardening)\\b", "labels": ["P1"] }
  ],
  "pr_path_rules": [
    { "path": "terraform/", "label": "area:infra" },
    { "path": "stack/", "label": "area:infra" },
    { "path": "dns/", "label": "area:infra" },
    { "path": "app/web/", "label": "area:web" },
    { "path": "app/bff/", "label": "area:bff" },
    { "path": "app/docs/", "label": "area:docs" },
    { "path": "docs/", "label": "area:docs" },
    { "path": "scripts/", "label": "area:ops" },
    { "path": ".github/", "label": "area:ops" },
    { "path": "CHANGELOG.md", "label": "area:ops" }
  ]
}
