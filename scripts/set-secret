#!/usr/bin/env bash
# Reads one secret from a hidden prompt (paste + Enter) and writes it into a git-ignored config file.
# Nothing is echoed or logged, so the value never reaches the terminal scrollback, git or a chat.
#   scripts/set-secret terraform/oci/terraform.tfvars tailscale_auth_key   # HCL:   key = "value"
#   scripts/set-secret stack/.env S3_SECRET_ACCESS_KEY                     # dotenv: KEY=value
set -euo pipefail
FILE="${1:?usage: scripts/set-secret <file> <name>}"; NAME="${2:?usage: scripts/set-secret <file> <name>}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
[ -f "$FILE" ] || { echo "no such file: $FILE" >&2; exit 1; }
git check-ignore -q "$FILE" || { echo "refusing: $FILE is not git-ignored" >&2; exit 1; }

read -r -s -p "Paste $NAME and press Enter (hidden): " VALUE; echo
VALUE="$(printf '%s' "$VALUE" | tr -d '\r\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
[ -n "$VALUE" ] || { echo "empty value, nothing written" >&2; exit 1; }

SECRET="$VALUE" python3 - "$FILE" "$NAME" <<'PY'
import os, re, sys
path, name, val = sys.argv[1], sys.argv[2], os.environ["SECRET"]
s = open(path).read()
if path.endswith(".tfvars"):
    pat, rep = rf'^{re.escape(name)}\s*=.*$', f'{name} = "{val}"'
else:
    pat, rep = rf'^{re.escape(name)}=.*$', f'{name}={val}'
s2, n = re.subn(pat, lambda m: rep, s, flags=re.M)
if n == 0:
    s2 = s.rstrip("\n") + "\n" + rep + "\n"
fd = os.open(path, os.O_WRONLY | os.O_TRUNC)
os.write(fd, s2.encode()); os.close(fd)
os.chmod(path, 0o600)
print(f"✓ {name} written to {path} ({len(val)} chars, mode 600)")
PY
