# OpenWA runtime config (VM wafine-vm). Copy to stack/.env ON THE VM (git-ignored) and fill in.
# Only variables that upstream OpenWA/docker-compose.yml forwards are honoured (it uses an
# explicit list, no env_file). Full reference: OpenWA/.env.example.
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

# ── Build ────────────────────────────────────────────────────────────────────
OPENWA_REF=main                 # tag for the locally built image (set to the git tag you checked out)
OPENWA_MEM_LIMIT=8g             # A1 Always Free = 12 GB total; whatsapp-web.js ~300-500 MB/session
TZ=UTC                          # OpenWA pins its DB sessions to UTC anyway

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# Tailscale-only phase: the tailnet URL printed by `tailscale serve status` on the VM.
# Once the public gateway hostname is live, switch these to https://gw.<your-domain>.
BASE_URL=TAILNET_ENDPOINT
DASHBOARD_URL=TAILNET_ENDPOINT
CORS_ORIGINS=TAILNET_ENDPOINT
TRUSTED_PROXIES=xxx.yyy.zzz.0/24  # compose network pinned in stack/compose.infra.yml (cloudflared lives there)
AUTO_START_SESSIONS=true
ENGINE_TYPE=whatsapp-web.js     # lower ban risk than baileys; costs more RAM

# First admin key: leave empty to let OpenWA generate /app/data/.api-key (read it once, store it in
# your password manager). PEPPER must be set BEFORE first boot and never changed afterwards.
API_MASTER_KEY=
API_KEY_PEPPER=

# ── Database: Supabase Postgres via the Supavisor SESSION pooler (IPv4, port 5432) ─────────────
# Host: Supabase dashboard > Connect > Session pooler (copy it; the aws-N prefix varies).
DATABASE_TYPE=postgres
DATABASE_HOST=SUPABASE_DB_POOLER
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=SUPABASE_DB)USER
DATABASE_PASSWORD=
POSTGRES_SCHEMA=SCHEMA_NAME
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true   # CA is mounted from stack/certs/supabase-ca.crt
DATABASE_POOL_SIZE=5
DATABASE_SYNCHRONIZE=false

# ── Media + backups: S3-compatible object storage ─────────────────────────────────────────
# Private Cloudflare R2 buckets `openwa-media` (chat-media archive) and `openwa-backups` (nightly
# dumps), EU jurisdiction, managed in terraform/cloudflare (docs/11-media-storage.md).
#   Endpoint: the .eu. form is mandatory, EU buckets are invisible on the plain account endpoint.
#   Keys: Cloudflare dashboard > R2 > Manage API tokens > "Object Read & Write" scoped to the two
#   buckets; stored in pass cloudflare/r2/openwa-vm.
#   Path style: R2 accepts it and OpenWA forces it whenever S3_ENDPOINT is set, so keep it true.
# S3_PROVIDER / S3_FORCE_PATH_STYLE are read by stack/preflight.sh, stack/backup.sh and
# stack/media-backfill.sh (rclone) and by the BFF signer — not by OpenWA itself.
# The media bucket is private and has no public hostname: the BFF reuses these values to mint
# short-lived presigned GET links for signed-in users (compose passes them to the bff service).
# Keep STORAGE_TYPE=local until the keys are set; preflight/backup then skip the store.
STORAGE_TYPE=s3
S3_PROVIDER=Cloudflare
S3_ENDPOINT='https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com'
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
S3_BUCKET=openwa-media
BACKUP_BUCKET=openwa-backups    # used by stack/backup.sh and stack/media-backfill.sh
S3_KEY_PREFIX=media/            # key prefix for archived media; no lifecycle expiry (owner: keep all data)
S3_ACCESS_KEY_ID=              # From pass cloudflare/r2/openwa-vm (R2 API token)
S3_SECRET_ACCESS_KEY=          # From pass cloudflare/r2/openwa-vm (R2 API token)
MEDIA_URL_TTL_SECONDS=300       # lifetime of a presigned media link handed out by the BFF

# ── Keep media out of Postgres, and prune on a schedule ────────────────────────────────────
# OpenWA writes every media payload as base64 into messages.metadata. The archive copies the bytes to
# the object store and sets mediaPath; the trigger in
# supabase/migrations/20261018130000_openwa_strip_archived_media.sql then drops the inline copy.
# Apply that migration BEFORE enabling the archive, and set the same values on EVERY node that
# shares the database.
# Rows stored before the archive was on: stack/media-backfill.sh (dry run by default).
CHAT_MEDIA_ARCHIVE_ENABLED=true
CHAT_MEDIA_ARCHIVE_OUTBOUND=true   # also archive media this account sends (REST sends inline it too)
# Media above the archive cap would stay inline in Postgres: never download more than can be archived.
# (MEDIA_DOWNLOAD_MAX_BYTES also caps URL-based sends and base64 sends of the REST API.)
CHAT_MEDIA_ARCHIVE_MAX_BYTES=26214400
MEDIA_DOWNLOAD_MAX_BYTES=26214400
# Retention. Media: 30 days here AND in the bucket lifecycle rule. Message rows: 90 days (OpenWA
# prunes daily). Audit log lives in main.sqlite on the node's volume: 1 year.
# Owner rule (2026-10-18): keep all data. 0 = keep forever for archived media, messages and the audit log.
# Change these only on the owner's explicit decision.
CHAT_MEDIA_ARCHIVE_TTL_DAYS=0
MESSAGE_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# from the Mac:  scripts/tf cloudflare output -raw tunnel_token
# Leave EMPTY for Tailscale-only mode (cloudflared is not started).
CLOUDFLARE_TUNNEL_TOKEN=

# ── Fallback public API entry point (docs/15 option B — needs owner approval) ─
# Caddy terminates TLS for this one hostname and proxies to the BFF. Leave EMPTY
# (default): the tunnel + Cloudflare for SaaS path (docs/15 option A) is the
# default and opens no inbound port. Setting a hostname here enables the `caddy`
# compose profile, which publishes ports 80 and 443 on the VM.
# CADDY_API_HOST=api.example.com
CADDY_API_HOST=

# ── Safety / anti-ban guardrails (see OpenWA README "Before you connect a number") ─────────
# OpenWA's pacing counts EVERY outgoing row of a session, including what the owner types on the
# phone or WhatsApp Web, so on a personal number its daily caps run out without any API use. The
# real API cap is the BFF's (API_SEND_* below, editable from /admin). Keep the engine's pacing on
# for its circuit breaker, with the daily cap raised to its maximum and the cold-reachout cap off.
SEND_PACING_ENABLED=true
SEND_PACING_WARMUP_SCHEDULE=100000
SEND_PACING_COLD_DAILY_CAP=off
SIMULATE_TYPING=true

# ── MCP for AI agents — reachable over Tailscale only (Cloudflare 404s /mcp) ─────────────
MCP_ENABLED=true
MCP_READONLY=false   # OpenWA engine MCP: false allows write/send tools on the engine's /mcp (docs/09). See BFF_MCP_READONLY for the BFF's /mcp surface.

# ── Observability ────────────────────────────────────────────────────────────
METRICS_TOKEN=

# ── BFF (Agentic Core) ──────────────────────────────────────────────────────
BFF_REF=main
# Gateway key the BFF sends as X-API-Key. Do not paste it here by hand: on the VM run
#   printf %s "$KEY" | ./stack/gateway-key.sh --stdin   # preferred: unscoped OPERATOR key
#   ./stack/gateway-key.sh                          # fallback: the engine's bootstrap admin key
# then ./stack/wa up -d bff. `./stack/gateway-key.sh --check` tests it against the live gateway.
OPENWA_API_KEY=              # Set after first deploy (from ./wa apikey)
# Leave empty (default-deny). Browsers never call the BFF: the Vercel server proxy (app/web /api/bff) does,
# server to server, and CORS only governs browsers. Set an origin only for a deliberate direct browser client.
BFF_CORS_ORIGINS=
# API send budget per WhatsApp session (defaults; admins change them live from /admin).
# Counts only /wa/*, /mcp and auto-reply sends.
API_SEND_DAILY_LIMIT=300
API_SEND_PER_MINUTE=10

# Sign-up / allowlist + admin dashboard (docs/08-signup-allowlist.md). Placeholders only — the real
# values live only in stack/.env on the VM. In production the BFF refuses to start (naming the var)
# when SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL or ADMIN_EMAILS is
# empty; stack/compose.infra.yml forwards each of these into the container.
#   SUPABASE_URL              https://<project-ref>.supabase.co  (the Project URL, never a key)
#   SUPABASE_ANON_KEY         Supabase > Project Settings > API > anon public
#   SUPABASE_SERVICE_ROLE_KEY Supabase > Project Settings > API > service_role (sign-up rollback only)
#   DATABASE_URL              Supabase session pooler: postgresql://...@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
#   DATABASE_CA_FILE          the CA stack/compose.infra.yml mounts read-only; pins TLS
#   ADMIN_EMAILS              comma-separated; an admin also needs a confirmed email
#   ALLOWLIST_SEED            comma-separated E.164 seeds, e.g. +212600000042
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_CA_FILE=/run/certs/supabase-ca.crt
ADMIN_EMAILS=
ALLOWLIST_SEED=

# OAuth for MCP connectors such as Claude (docs/10-claude-connector.md). Generate once on the VM:
#   openssl rand -base64 32
# It encrypts the per-connection OpenWA keys; changing it disconnects every connector. Empty = OAuth off.
OAUTH_ENC_KEY=
WEB_URL=https://app.example.com          # public web origin (hosts /oauth/consent)
PUBLIC_API_URL=https://api.example.com   # public BFF origin shown to users (REST base, MCP URL)

# OpenWA webhooks/ingress queue (optional). Requires Redis (already provided by this stack).
# TRADE-OFF (OpenWA docs/11-operational-runbooks.md): QUEUE_ENABLED=true makes webhook/ingress dispatch durable
# from enqueue onward and survives abrupt crashes; adds Redis load/reliability surface.
# QUEUE_ENABLED=false
BFF_MCP_READONLY=true # BFF /mcp surface: set to false to let user agents send via the BFF /mcp (captain decision 2026-10-14, not yet enabled)
