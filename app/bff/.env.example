# BFF environment variables (example values - use your own)
# Real values: pass or per-env secrets (never commit)

# Public URLs
PUBLIC_API_URL=https://api.example.com
WEB_URL=https://app.example.com

# CORS
CORS_ORIGINS=https://app.example.com,https://docs.example.com

# OAuth encryption (32 random bytes base64, never commit real value)
# Generate: openssl rand -base64 32
OAUTH_ENC_KEY=change-me-32-bytes-base64

# OpenWA engine
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=change-me-openwa-admin-key

# Valkey/Redis
REDIS_URL=redis://localhost:6379

# Database (Supabase session pooler)
DATABASE_URL=postgresql://user:password@db-<region>.pooler.example.com:5432/postgres

# MCP integration
OPENWA_MCP_URL=http://localhost:2785/mcp
OPENWA_MCP_KEY=change-me-openwa-key

# Logging
LOG_LEVEL=info
